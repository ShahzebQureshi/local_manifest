<manifest>
  <remote name="ShahzebQureshi" fetch="https://github.com/ShahzebQureshi/" revision="lineage-24.0" />
  <remote name="lineageos" fetch="https://github.com/LineageOS/" revision="lineage-24.0" />

  <!-- make sure no other manifest claims vendor/oneplus -->
  <remove-project name="TheMuppets/proprietary_vendor_oneplus" optional="true" />

  <!-- Device Trees -->
  <project path="device/oneplus/hotdogg"
           name="android_device_oneplus_hotdogg"
           remote="ShahzebQureshi"
           revision="hotdogg-24.0" />

  <project path="device/oneplus/sm8150-common"
           name="android_device_oneplus_sm8150-common"
           remote="lineageos" />

  <!-- Kernel -->
  <project path="kernel/oneplus/sm8150"
           name="android_kernel_oneplus_sm8150"
           remote="lineageos" />

  <!-- Vendor (one repo holds hotdogg/ and sm8150-common/) -->
  <project path="vendor/oneplus"
           name="proprietary_vendor_oneplus_hotdogg"
           remote="ShahzebQureshi" />

  <!-- Hardware -->
  <project path="hardware/oplus"
           name="android_hardware_oplus"
           remote="lineageos" />

</manifest>
